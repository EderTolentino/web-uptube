# Copy this file to .env and provide your own values. Never commit .env.
DB_HOST=localhost
DB_USER=your_mysql_user
DB_PASSWORD=your_mysql_password
DB_DATABASE=uptube

# Generate a long, random secret for sessions
SESSION_SECRET=replace_with_a_long_random_secret

# Optional OAuth integrations: configure credentials in Google/GitHub developer consoles
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Email confirmation: use a dedicated SMTP account and an app password
SMTP_USER=
SMTP_PASSWORD=
